# Anthropic API key (server only). Required unless ANALYZE_MOCK=1.
ANTHROPIC_API_KEY=
# Model used by /api/analyze (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Effort level for the model (default: medium)
ANTHROPIC_EFFORT=medium
# Set to 1 to return a canned blueprint without calling the API
ANALYZE_MOCK=
# Optional webhook that receives feedback submissions
FEEDBACK_WEBHOOK_URL=
# Optional Plausible analytics domain (client-side, public)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
