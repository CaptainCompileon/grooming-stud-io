# Anthropic API key (server only). Required unless ANALYZE_MOCK=fixture (dev only).
ANTHROPIC_API_KEY=
# Model used by /api/analyze (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Effort level for the model (default: medium)
ANTHROPIC_EFFORT=medium
# Set to "fixture" to return a canned blueprint without calling the API.
# Dev only (`npm run dev`): ignored when NODE_ENV=production (next build / next start).
ANALYZE_MOCK=
# Optional webhook that receives feedback submissions
FEEDBACK_WEBHOOK_URL=
# Optional Plausible analytics domain (client-side, public)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
